"""
            if data['open_ports']:
                for port, banner in data['open_ports'].items():
                    html_content += f"<tr><td>{port}</td><td class ='open'>Open</td><td><pre style='margin:0; font-family:inherit;'>{banner}</pre></td></tr>"
            else:
                html_content += "<tr><td colspan='3' style='text-align:center; color:#8b949e;'>No open ports detected or target offline.</td></tr>"

            html_content += "</table></div>"
        html_content += """
    <div class="footer">Generated automatically by NET SCAN Tool v2.0</div>
</body>
</html>"""
        with open(args.html, "w", encoding="utf-8") as file:
            file.write(html_content)
        console.print(f"\n[green3][+] HTML Report successfully saved to {args.html}")
        logging.info(f"HTML Report successfully saved to {args.html}")
