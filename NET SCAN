    <h1>NET SCAN Security Report</h1>
                """
        for target, data in all_scan_results.items():
            html_content += f"""
    <div class="target-box">
        <h2>Target IP: {target}</h2>
        <div class="meta-info">
            <strong>Path:</strong> {data['path']} &nbsp;|&nbsp;
